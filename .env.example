# Database Configuration (Docker local: port 5433 or 5432)
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASS=postgres
DB_NAME=innerpeace_db
NODE_ENV=development
DB_SSL=false

# Server Configuration
PORT=3000

# CORS (comma-separated origins)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# JWT Authentication
JWT_SECRET=change_this_to_a_secure_jwt_secret
JWT_EXPIRES_IN=7d

# Email Service (Nodemailer / SMTP)
FRONTEND_URL=http://localhost:5173/reset-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
MAIL_FROM="InnerPeace <noreply@innerpeace.local>"

# AWS S3 Storage (optional for local dev)
AWS_BUCKET=innerpeace-bucket-objects-store
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=dummy_access_key
AWS_SECRET_ACCESS_KEY=dummy_secret_key
AWS_S3_PUBLIC_BASE_URL=https://d1997ddho4gari.cloudfront.net
