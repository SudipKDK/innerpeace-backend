# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=innerpeace_db
NODE_ENV=development
DB_SSL=false

# Server Configuration
PORT=3000

# CORS (comma-separated origins)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# JWT Authentication
JWT_SECRET=change_this_to_a_secure_jwt_secret
JWT_EXPIRES_IN=7d

# Email Service (Nodemailer / SMTP)
FRONTEND_URL=http://localhost:5173/reset-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
MAIL_FROM="InnerPeace <noreply@innerpeace.local>"

# AWS S3 Storage (for media uploads)
AWS_BUCKET=innerpeace-bucket-objects-store
AWS_REGION=ap-south-1
# AWS credentials use IAM Roles in production (or ~/.aws/credentials locally)
AWS_S3_PUBLIC_BASE_URL=https://innerpeace-bucket-objects-store.s3.ap-south-1.amazonaws.com
